rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Name-only identity: anyone signed in (anonymously) who knows a name can
    // open that log. People can't be listed, so names can't be browsed.
    // Tighten to request.auth.uid when real sign-in lands.
    match /people/{personId} {
      // Deleting an account needs delete here and on its subcollections.
      allow get, create, update, delete: if request.auth != null;

      match /meals/{mealId} {
        allow read, write: if request.auth != null;
      }
      match /weights/{date} {
        allow read, write: if request.auth != null;
      }
      match /days/{date} {
        allow read, write: if request.auth != null;
      }
    }

    // Legacy per-device data, read once when a device first enters a name.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /meals/{mealId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
